    "Type searches in this language. German searches are turned into English on this Mac before Teinte reads them. Text in quotes is searched as written.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen in dieser Sprache eingeben. Deutsche Suchen werden auf diesem Mac ins Englische übertragen, bevor Teinte sie liest. Text in Anführungszeichen wird so gesucht, wie er geschrieben ist."
          }
        }
      }
    },
